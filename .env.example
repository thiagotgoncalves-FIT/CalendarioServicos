# Configuração de Integração com o Backend Xano
# Substitua a URL abaixo pela URL Base do seu API Group no Xano (ex: https://x8ki-letl-twmt.n7.xano.io/api:xxxxxx)
XANO_API_URL=https://sua-instancia.xano.io/api:agendai

# Modo de desenvolvimento (opcional: True para usar mock local caso a API do Xano esteja offline)
USE_MOCK_FALLBACK=True
